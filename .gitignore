.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Private source captures and generated agent traces.
vault/
runs/
.magazine/
.playwright-cli/
node_modules/
engine/view/dist/

# Reproducible build output; release manifests remain in editions/.
output/
tmp/

# Generated design-study previews stay available locally and are reproducible
# from the versioned prototype source and gallery.
prototypes/design-directions/previews/

# Agent work queue: briefs embed whole source extractions and are
# regenerated on demand. Provenance lives in production/articles/.
editions/*/production/agent/

# mag run/render outputs inside edition dirs; promote finals into the edition proper.
editions/*/run-*/
editions/*/render-*/
