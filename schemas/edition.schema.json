{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edition.schema.json",
  "title": "Magazine edition",
  "type": "object",
  "required": ["id", "issue_number", "title", "publication_date", "editorial", "cover", "articles"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "issue_number": {"type": ["string", "integer"]},
    "title": {"type": "string", "minLength": 1},
    "publication_date": {"type": "string", "format": "date"},
    "editorial": {"type": "string"},
    "cover": {
      "type": "object",
      "required": ["headline"],
      "properties": {
        "masthead": {"type": "string"},
        "headline": {"type": "string"},
        "back_text": {"type": "string"}
      }
    },
    "articles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "author", "source_ids", "manuscript", "fidelity"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "author": {"type": "string"},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "manuscript": {"type": "string"},
          "fidelity": {"type": "string"}
        }
      }
    }
  }
}

