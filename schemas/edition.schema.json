{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edition.schema.json",
  "title": "Magazine edition",
  "type": "object",
  "required": ["id", "issue_number", "title", "publication_date", "editorial", "cover", "articles"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "issue_number": {"type": ["string", "integer"]},
    "title": {"type": "string", "minLength": 1},
    "publication_date": {"type": "string", "format": "date"},
    "editorial": {"type": "string"},
    "cover": {
      "type": "object",
      "required": ["headline"],
      "properties": {
        "headline": {"type": "string"},
        "back_text": {"type": "string"}
      }
    },
    "articles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "short_title", "opener_variant", "author", "author_note", "source_ids", "manuscript", "fidelity"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "short_title": {"type": "string", "minLength": 1, "maxLength": 40},
          "display_emphasis": {"type": "string"},
          "opener_variant": {"type": "string", "enum": ["edge_medallion", "split_axis", "stepped_title"]},
          "author": {"type": "string"},
          "author_note": {"type": "string", "minLength": 1, "maxLength": 160},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "manuscript": {"type": "string"},
          "fidelity": {"type": "string"},
          "figures": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["id", "decision", "source_id", "asset_id", "caption", "alt_text", "anchor", "layout", "criteria", "rationale"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "decision": {"const": "include"},
                "source_id": {"type": "string", "minLength": 1},
                "asset_id": {"type": "string", "minLength": 1},
                "caption": {"type": "string", "minLength": 1},
                "alt_text": {"type": "string", "minLength": 1},
                "anchor": {"type": "string", "minLength": 1},
                "layout": {"enum": ["evidence_band", "column_plate"]},
                "criteria": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"enum": ["important", "useful", "beautiful", "cool"]}
                },
                "rationale": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
