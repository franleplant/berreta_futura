{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-record.schema.json",
  "title": "Magazine source record",
  "type": "object",
  "required": ["schema_version", "id", "title", "canonical_url", "submitted_url", "captured_at", "kind", "status", "rights"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "author": {"type": ["string", "null"]},
    "canonical_url": {"type": "string", "format": "uri"},
    "submitted_url": {"type": "string", "format": "uri"},
    "captured_at": {"type": "string", "format": "date-time"},
    "publication_date": {"type": ["string", "null"]},
    "kind": {"enum": ["article", "post", "thread", "slides", "pdf", "video", "web", "other"]},
    "status": {"enum": ["captured", "extracted", "reviewed", "failed"]},
    "content_hash": {"type": ["string", "null"]},
    "raw_captures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "method", "captured_at", "artifact_count", "byte_count"],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "path": {"type": "string"},
          "method": {"type": "string"},
          "captured_at": {"type": "string", "format": "date-time"},
          "artifact_count": {"type": "integer", "minimum": 1},
          "byte_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "media_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capture_id", "status", "assets"],
        "properties": {
          "capture_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["no_media", "media_rejected", "media_curated", "media_blocked"]},
          "note": {"type": "string"},
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "artifact_path", "artifact_sha256", "mime_type", "creator", "credit", "rights"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "artifact_path": {"type": "string", "minLength": 1},
                "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "mime_type": {"enum": ["image/jpeg", "image/png"]},
                "creator": {"type": "string", "minLength": 1},
                "credit": {"type": "string", "minLength": 1},
                "rights": {"type": "object"}
              }
            }
          }
        }
      }
    },
    "provenance": {"type": "array", "items": {"type": "object"}},
    "rights": {"type": "object"},
    "metadata": {"type": "object"},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
